<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- .NET Framework 4.8 ships with Windows 10 and 11, so the .exe runs without installing anything. -->
    <TargetFramework>net48</TargetFramework>
    <LangVersion>latest</LangVersion>
    <AssemblyName>TabbedNotepad</AssemblyName>
    <RootNamespace>TabbedNotepad</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <!-- Shown in Windows Explorer: right-click TabbedNotepad.exe > Properties > Details. -->
    <Version>1.5.0</Version>
    <FileVersion>1.5.0.0</FileVersion>
    <AssemblyTitle>Tabbed Notepad for better productivity</AssemblyTitle>
    <Product>Tabbed Notepad application by WebProgress.AI</Product>
    <Company>WebProgress.AI</Company>
    <Description>Tabbed Notepad for better productivity. Idea and product design: WebProgress.AI</Description>
    <Copyright>© 2026 WebProgress.AI</Copyright>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <GenerateAppConfigFile>false</GenerateAppConfigFile>
    <DebugType>none</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <!-- The screenshot/check tool in tools/Screenshots drives the app's internals. -->
    <InternalsVisibleTo Include="Screenshots" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Drawing" />
    <Reference Include="System.IO.Compression" />
  </ItemGroup>

</Project>
